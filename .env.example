# These can all be left blank and set later in the web UI (Settings → Connections),
# which stores them privately under runtime/settings.json. Any value set here in
# the environment WINS over the UI and locks that field as read-only. Override the
# store location with PRISM_CONFIG_FILE (default: alongside the SQLite DB).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=

EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

VAULT_PATH=/data/research-vault
SQLITE_PATH=/data/prism.sqlite3
ARCHIVE_PATH=/data/archives
LANCEDB_PATH=/data/lancedb
PRISM_UID=1000
PRISM_GID=1000

# Web UI only. Docker Compose publishes the web UI on all interfaces (8000:8000)
# and binds the app to 0.0.0.0; PRISM_WEB_HOST here only affects non-Docker runs.
PRISM_WEB_HOST=127.0.0.1
PRISM_WEB_PORT=8000
PRISM_WEB_RELOAD=0
PRISM_WEB_STATIC=
# Web UI login. Leave these BLANK to create the owner account from the UI on
# first run (recommended) — the credential is stored, hashed, under runtime/.
# Set them here only if you'd rather pin the credential via env; doing so also
# disables the in-UI account creation. A signed session cookie keeps you logged
# in afterwards. (On a LAN-exposed bind with no account yet, the first browser
# to connect creates it — keep PRISM on a trusted network.)
PRISM_WEB_USERNAME=
PRISM_WEB_PASSWORD=
# Optional: override where the hashed credential is stored (default: alongside
# the SQLite DB, e.g. /data/web-auth.json in Docker).
PRISM_WEB_AUTH_FILE=
# Optional: pin the session-cookie signing key (else derived from the password,
# so changing the password logs everyone out). Set when serving behind HTTPS:
PRISM_WEB_SESSION_SECRET=
PRISM_WEB_COOKIE_SECURE=0

# Fetching safety. Leave unset unless you intentionally capture private/LAN URLs.
PRISM_FETCH_ALLOW_PRIVATE=0
# Sends hard-blocked website URLs through https://r.jina.ai/ when enabled.
PRISM_FETCH_USE_JINA_READER=1

# Worker only (prism-worker): scheduled feed ingestion + graph maintenance.
# Copy feeds.example.yaml to runtime/feeds.yaml to configure feeds and schedules.
# Schedule timezone is set in feeds.yaml (default Europe/Copenhagen), not here.
PRISM_FEEDS_PATH=/data/feeds.yaml
# Set to 1 to also run feed ingestion immediately on worker startup.
PRISM_WORKER_RUN_AT_START=0
