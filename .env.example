TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=

EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

VAULT_PATH=/data/research-vault
SQLITE_PATH=/data/prism.sqlite3
ARCHIVE_PATH=/data/archives
LANCEDB_PATH=/data/lancedb
PRISM_UID=1000
PRISM_GID=1000

# Web UI only. Docker Compose publishes the web UI on 127.0.0.1 by default.
PRISM_WEB_HOST=127.0.0.1
PRISM_WEB_PORT=8000
PRISM_WEB_RELOAD=0
PRISM_WEB_STATIC=
# Optional Basic Auth for the web UI. Set both before exposing beyond localhost.
PRISM_WEB_USERNAME=
PRISM_WEB_PASSWORD=

# Fetching safety. Leave unset unless you intentionally capture private/LAN URLs.
PRISM_FETCH_ALLOW_PRIVATE=0
# Sends hard-blocked website URLs through https://r.jina.ai/ when enabled.
PRISM_FETCH_USE_JINA_READER=1

# Worker only (prism-worker): scheduled feed ingestion + graph maintenance.
# Copy feeds.example.yaml to runtime/feeds.yaml to configure feeds and schedules.
# Schedule timezone is set in feeds.yaml (default Europe/Copenhagen), not here.
PRISM_FEEDS_PATH=/data/feeds.yaml
# Set to 1 to also run feed ingestion immediately on worker startup.
PRISM_WORKER_RUN_AT_START=0
